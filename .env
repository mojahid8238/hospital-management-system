# --------------------------------------------------------------------------------
# Jitsi Meet Clean Start Configuration
# --------------------------------------------------------------------------------

# Directory for persistent configuration
CONFIG=./jitsi-config

# Standard Jitsi Ports
HTTP_PORT=8000
HTTPS_PORT=8443

# SSL/HTTPS Logic
# We use HTTPS because browsers require it for Camera/Mic access.
ENABLE_HTTP_REDIRECT=1

# System time zone
TZ=UTC

# Public URL - This must match how you access the site in your browser
PUBLIC_URL=https://localhost:8443

# Internal Container Networking
XMPP_SERVER=prosody
XMPP_DOMAIN=localhost
XMPP_AUTH_DOMAIN=auth.localhost
XMPP_MUC_DOMAIN=muc.localhost
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.localhost
XMPP_GUEST_DOMAIN=guest.localhost
XMPP_RECORDER_DOMAIN=recorder.localhost
XMPP_HIDDEN_DOMAIN=hidden.localhost

# Domain/IP Configuration (For local testing)
DOCKER_HOST_ADDRESS=127.0.0.1
JVB_ADVERTISE_IPS=127.0.0.1

# Security - Framing (Allow embedding in the medical app)
X_FRAME_OPTIONS=

# Authentication - Disabled for simple local usage
ENABLE_AUTH=0
ENABLE_GUESTS=0

# Security - Essential Service Passwords
JICOFO_AUTH_PASSWORD=jico_pass_76f5cbc21369
JVB_AUTH_PASSWORD=jvb_pass_49d883b4213a
JIGASI_XMPP_PASSWORD=jigasi_pass_5a3c2506a
JIBRI_RECORDER_PASSWORD=jibri_rec_dd9d9aa617
JIBRI_XMPP_PASSWORD=jibri_xmpp_f8312f5919

# Misc
JITSI_IMAGE_VERSION=stable
RESTART_POLICY=unless-stopped
